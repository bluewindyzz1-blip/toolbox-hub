# Required when database-backed catalog and authentication are enabled.
DATABASE_URL=
OWNER_OPEN_ID=

# Existing OAuth / platform configuration. Leave blank unless the deployment platform provides values.
OAUTH_SERVER_URL=
VITE_APP_ID=
JWT_SECRET=

# Public canonical origin, without a trailing slash. Example: https://example.com
CANONICAL_ORIGIN=

# Google AdSense. Leave all values blank until Google issues your actual Publisher ID and ad slot IDs.
# Never commit real production identifiers to source control.
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_SLOT_AD_TOP=
VITE_ADSENSE_SLOT_AD_CONTENT=
VITE_ADSENSE_SLOT_AD_RELATED=

# Optional future search notification integration. No IndexNow request is sent by the current application.
INDEXNOW_API_KEY=

# Optional privacy-aware analytics. Both fields must be set for the client script to load.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional public support email shown on the contact page.
VITE_CONTACT_EMAIL=

# Public canonical origin injected into browser-side canonical and Open Graph metadata.
VITE_CANONICAL_ORIGIN=
